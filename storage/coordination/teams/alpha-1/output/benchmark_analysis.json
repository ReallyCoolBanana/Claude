  "anomalies": [
    {
      "id": "ANOM-001",
      "severity": "critical",
      "description": "Proto A throughput is only 20.9% of baseline (31.64 vs 151.1 dp/s) - a 79.1% reduction",
      "affected": "Proto A all scenarios",
      "likely_cause": "Excessive rate limit denials (11,916 denials out of 18,442 checks = 64.6% denial rate) throttling data collection"
    },
    {
      "id": "ANOM-002",
      "severity": "critical",
      "description": "Proto A has 11,916 rate limit denials across 12 runs (64.6% denial rate). Baseline and Proto B have zero denials.",
      "affected": "Proto A rate limiter",
      "likely_cause": "Proto A's file-bus-based rate limiter is too aggressive or has contention issues with shared bus file"
    },
    {
      "id": "ANOM-003",
      "severity": "high",
      "description": "Proto A receives ~7.5x more messages than it sends (mean recv=4134 vs sent=551). This indicates agents are re-reading the entire bus file on each poll.",
      "affected": "Proto A bus architecture",
      "likely_cause": "Append-only bus file causes O(n) read amplification as agents re-read all historical messages"
    },
    {
      "id": "ANOM-004",
      "severity": "medium",
      "description": "Proto A peak memory is 322KB mean vs baseline 96KB (3.4x higher), with max spike to 1804KB",
      "affected": "Proto A memory",
      "likely_cause": "Bus file accumulation and message buffering"
    },
    {
      "id": "ANOM-005",
      "severity": "medium",
      "description": "Proto B p95 latency (0.599ms) is 2.1x higher than baseline (0.285ms) with high variability (stdev=0.230ms)",
      "affected": "Proto B tail latency",
      "likely_cause": "FIFO/mmap overhead causes occasional latency spikes"
    },
    {
      "id": "ANOM-006",
      "severity": "high",
      "description": "Proto A collects exactly 300 data points in S1 (1 team, 15s) and S4 (2 teams, 20s with failure injection) scenarios across all 3 runs each - suggesting a hard cap or severe bottleneck at ~20 dp/s",
      "affected": "Proto A data collection rate",
      "likely_cause": "Rate limiter is capping at 20 ops/sec regardless of duration or team count"
    },
    {
      "id": "ANOM-007",
      "severity": "low",
      "description": "Scenario S4 has inject_failure=true but zero errors across all prototypes. Failure injection appears non-functional.",
      "affected": "Test framework",
      "likely_cause": "Failure injection may not be implemented in the benchmark harness"
    },
    {
      "id": "ANOM-008",
      "severity": "medium",
      "description": "Live Proto A test shows 53 messages sent but only 51 received (96.2% delivery rate), indicating 2 lost messages",
      "affected": "Proto A live message reliability",
      "likely_cause": "Race condition in file-based bus write/read cycle"
    }
  ],
  "key_findings": [
    {
      "id": "F-001",
      "priority": "critical",
      "title": "Proto A throughput collapse - 79.1% below baseline",
      "summary": "Proto A achieves only 31.64 dp/s vs baseline 151.1 dp/s. Root cause is rate limiter denying 64.6% of requests. Proto A collects only 6,526 total data points vs baseline 32,181 (79.7% fewer)."
    },
    {
      "id": "F-002",
      "priority": "critical",
      "title": "Proto A rate limiter is fundamentally broken",
      "summary": "11,916 out of 18,442 rate limit checks (64.6%) are denied. This is the primary bottleneck destroying Proto A performance. The file-bus-based rate limiter has severe contention."
    },
    {
      "id": "F-003",
      "priority": "high",
      "title": "Proto B achieves near-baseline performance with coordination",
      "summary": "Proto B throughput (150.16 dp/s) is 99.4% of baseline with zero rate limit denials, successful heartbeating, and zero bus file overhead. The FIFO/mmap architecture is significantly more efficient."
    },
    {
      "id": "F-004",
      "priority": "high",
      "title": "Proto A file bus creates massive I/O overhead",
      "summary": "Proto A accumulates 2,080,457 bytes of bus file data (318.8 bytes per data point). Message receive amplification is 7.5x (agents re-read entire bus history)."
    },
    {
      "id": "F-005",
      "priority": "high",
      "title": "Proto B FIFO architecture eliminates bus overhead",
      "summary": "Proto B has zero bus file bytes, zero rate limit denials, and near-baseline throughput. The FIFO+mmap design avoids the read-amplification and rate-limiter contention problems of Proto A."
    },
    {
      "id": "F-006",
      "priority": "medium",
      "title": "Proto B has higher tail latency than baseline",
      "summary": "Proto B p95 latency is 0.599ms vs baseline 0.285ms (2.1x higher). The FIFO/mmap overhead causes occasional latency spikes, though mean latency remains low."
    },
    {
      "id": "F-007",
      "priority": "medium",
      "title": "Live tests confirm benchmark patterns",
      "summary": "Live Proto A: 70 data points in 34s (2.05 dp/s) with 15KB bus file. Live Proto B: 60 data points in 37s (1.64 dp/s) with zero bus bytes. Live Baseline: 60 data points in 30s (2.0 dp/s). All zero errors."
    },
    {
      "id": "F-008",
      "priority": "medium",
      "title": "Proto B live test shows higher mmap operations",
      "summary": "Live Proto B performed 412 mmap operations and 98 file I/O ops for 60 data points (6.9 mmap ops per data point). Phase transitions are properly tracked (init -> gathering -> validation -> done)."
    },
    {
      "id": "F-009",
      "priority": "low",
      "title": "Failure injection (S4) appears non-functional",
      "summary": "Scenario S4 configures inject_failure=true but all prototypes report zero errors. The failure injection mechanism may not be implemented."
    },
    {
      "id": "F-010",
      "priority": "low",
      "title": "All prototypes show zero errors across all tests",
      "summary": "Zero errors in all 36 benchmark runs and all 3 live tests. While good for reliability, combined with finding F-009, this may indicate insufficient error testing."
    }
  ],
  "improvement_recommendations": [
    {
      "id": "R-001",
      "priority": "critical",
      "target": "Proto A",
      "recommendation": "Fix rate limiter - replace file-bus-based rate limiting with in-memory or FIFO-based approach. Current 64.6% denial rate destroys throughput.",
      "expected_impact": "Should increase Proto A throughput by 4-5x to match Proto B/baseline levels"
    },
    {
      "id": "R-002",
      "priority": "critical",
      "target": "Proto A",
      "recommendation": "Eliminate bus file read amplification. Currently agents re-read entire bus history on each poll. Implement cursor/offset-based reading or switch to FIFO model.",
      "expected_impact": "Would reduce messages_received from 7.5x to ~1x of messages_sent"
    },
    {
      "id": "R-003",
      "priority": "high",
      "target": "Proto B",
      "recommendation": "Investigate and reduce p95 latency spikes. Consider reducing mmap operation frequency (currently 6.9 per data point).",
      "expected_impact": "Could reduce p95 latency from 0.60ms to closer to baseline 0.28ms"
    },
    {
      "id": "R-004",
      "priority": "high",
      "target": "Test Framework",
      "recommendation": "Implement failure injection in benchmark harness. S4 scenario with inject_failure=true produces no errors.",
      "expected_impact": "Would enable testing resilience and error recovery paths"
    },
    {
      "id": "R-005",
      "priority": "medium",
      "target": "Proto A",
      "recommendation": "Add bus file rotation or compaction. Current implementation accumulates ~173KB per run with no cleanup.",
      "expected_impact": "Would reduce memory usage and improve read performance"
    },
    {
      "id": "R-006",
      "priority": "medium",
      "target": "Both Prototypes",
      "recommendation": "Add error injection and chaos testing to validate fault tolerance claims. Both prototypes show zero errors which may mask fragility.",
      "expected_impact": "Would reveal actual failure modes and recovery capabilities"
    },
    {
      "id": "R-007",
      "priority": "low",
      "target": "Proto B",
      "recommendation": "Optimize FIFO throughput. Current live test shows 2.67 ops/sec which could be improved with batching.",
      "expected_impact": "Minor throughput improvement in real-world scenarios"
    }
  ],
