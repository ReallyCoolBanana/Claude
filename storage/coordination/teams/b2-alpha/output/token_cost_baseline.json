      {
        "area": "Index files read-to-filter",
        "description": "Reading full index.json files to find 1-5 entries. storage/sources/index.json (27744 chars) and storage/scripts/index.json (26736 chars) are read in full for simple lookups.",
        "waste_tokens": 19713,
        "improvement": "Queryable indexes or summary files would reduce reads from ~6900 tokens per index to ~50 tokens per query"
